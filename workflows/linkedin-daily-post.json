      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Mark as Posted",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1180, -100],
      "notes": "يحدّث نفس الصف (بالمطابقة على row_number) ويضع Status = Posted. لا يعمل إلا بعد نجاح النشر."
    }
