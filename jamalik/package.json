    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "hast-util-select": "^6.0.4",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
