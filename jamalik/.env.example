# ---------------------------------------------------------------------------
# جمالِك — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا تضع أي مفاتيح حقيقية هنا.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# قاعدة البيانات (PostgreSQL) — رابطان لا رابط واحد
#
# DATABASE_URL : اتصال التطبيق وقت التشغيل.
#   على Vercel استخدمي مجمّع الاتصالات (Transaction pooler) وأضيفي
#   ?pgbouncer=true&connection_limit=1 — بدونها تستنفد الدوال بلا خوادم
#   حدّ اتصالات القاعدة بسرعة.
#
# DIRECT_URL   : اتصال مباشر تستخدمه الهجرات فقط.
#   مجمّعات الاتصال بنمط transaction لا تدعم عبارات DDL، فتفشل الهجرات عبرها.
#   في Supabase اختاري Session pooler أو Direct connection.
#
# في التطوير المحلي: اجعلي القيمتين متطابقتين.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jamalik?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/jamalik?schema=public"

# العنوان العام للموقع بدون شرطة في النهاية — يُستخدم في canonical و sitemap و OG
NEXT_PUBLIC_SITE_URL="https://example.com"

# مفتاح توقيع جلسات لوحة التحكم.
# ولّده بالأمر: openssl rand -base64 48
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# التكاملات — تُدار أيضًا من لوحة التحكم (الإعدادات)، وقيمة قاعدة البيانات لها الأولوية.
# اتركها فارغة لتعطيل التكامل بالكامل.
# ---------------------------------------------------------------------------

# Google Analytics 4 — مثال: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# Google Search Console — قيمة الميتا الخاصة بالتحقق
GOOGLE_SITE_VERIFICATION=""

# Google AdSense — مثال: ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=""

# مزوّد البريد للنشرة البريدية (Mailchimp / Brevo / ConvertKit ...)
# اتركه فارغًا ليُخزَّن المشتركون في قاعدة البيانات فقط.
EMAIL_PROVIDER="none"
EMAIL_PROVIDER_API_KEY=""
EMAIL_PROVIDER_LIST_ID=""

# بيانات حساب المدير الأول — تُستخدم مرة واحدة عند تشغيل: npm run db:seed
# غيّرها قبل التشغيل، ولا تتركها كما هي في بيئة الإنتاج.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="مدير الموقع"

# ---------------------------------------------------------------------------
# تعبئة لمرة واحدة على منصّة النشر
#
# عيّنيه true قبل أول نشر ليُعبّئ سكربت البناء قاعدة البيانات تلقائيًا،
# ثم **احذفي المتغيّر** بعد نجاح النشر.
#
# سبب الحذف: التعبئة تعيد كتابة محتوى المقالات إلى نصوصه الأصلية، فلو بقيت
# مفعّلة لأُلغيت تعديلاتك التحريرية عند كل إعادة بناء.
# ---------------------------------------------------------------------------
RUN_SEED=""
